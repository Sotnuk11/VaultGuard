# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Used only to create the first admin when the database is empty (min 12 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- dead man's switch (checker.py) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECIPIENT_EMAIL=
RECIPIENT_PUBLIC_KEY_PATH=keys/recipient_public.pem
TIMEOUT_MINUTES=1440
POLL_SECONDS=60
